# 복기 웹앱 환경변수 (이름만; 값은 .env에, .env는 git 제외)
DATABASE_URL=postgresql://bokgi:…@127.0.0.1:5434/bokgi
SESSION_SECRET=…                      # 32바이트 이상 랜덤 (base64)
PUBLIC_ORIGIN=http://localhost:3000   # 운영: https://bokgi.ifsave.com
APP_TZ=Asia/Seoul
AI_ENABLED=false                      # 베타 기본: 템플릿 질문·해설만
AI_API_KEY=…
AI_BASE_URL=https://integrate.api.nvidia.com/v1
AI_MODEL=google/gemma-4-31b-it
AI_FALLBACK_API_KEY=…
AI_FALLBACK_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
AI_FALLBACK_MODEL=gemini-3.1-flash-lite
AI_DAILY_CALL_CAP=300
INVITE_ADMIN_TOKEN=…                  # scripts/invite.ts 로컬 발급용(선택)
