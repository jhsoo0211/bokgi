{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:bokgi:schema:card:v1",
  "title": "복기 카드",
  "description": "카드 한 장 = 사례 한 개 = 판단 한 번. 구획은 셋뿐이다: public(판단 전, web/src/shared/contract.ts의 PublicCase에서 id·version을 뺀 것), reveal(공개 뒤, contract의 Outcome·keyPoints와 학습 포인트), internal(서버 전용). public에는 회사명·티커·제품명·절대 날짜·결과 수치가 없어야 하며 tools/cards/check_case.py가 검사한다.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "version", "status", "deckOrder", "public", "reveal", "internal"],
  "properties": {
    "id": {
      "description": "카드 uuid v4(소문자). 티커·날짜가 든 슬러그는 쓰지 않는다.",
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "version": {"description": "카드 버전. 내용이 바뀔 때마다 1씩 올린다.", "type": "integer", "minimum": 1},
    "status": {"description": "draft → reviewed → live. 시드는 live만 덱에 넣는다.", "enum": ["draft", "reviewed", "live"]},
    "deckOrder": {
      "description": "덱 순서(1부터). live 카드 사이에서 유일. 결과 균형(같은 상태 3연속 금지)은 tools/cards/pick_case.py가 굳힌다.",
      "type": "integer",
      "minimum": 1
    },
    "public": {"$ref": "#/$defs/public"},
    "reveal": {"$ref": "#/$defs/reveal"},
    "internal": {"$ref": "#/$defs/internal"}
  },
  "$defs": {
    "index14": {
      "description": "파생 지수 14점(원시 가격 아님). 첫 값은 100: 흐름 판은 창의 첫 날 = 100(프로토타입 '처음 = 100'), 결과 경로는 판단일 = 100. 결과 경로의 끝값은 100 + 수익률.",
      "type": "array",
      "minItems": 14,
      "maxItems": 14,
      "prefixItems": [{"const": 100}],
      "items": {"type": "number", "exclusiveMinimum": 0}
    },
    "relativeDay": {"description": "판단일 기준 상대 날짜. 예: 판단일 D-12", "type": "string", "pattern": "^판단일 D-[0-9]+$"},
    "isoDate": {"type": "string", "pattern": "^(19|20)[0-9]{2}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$"},
    "shortText": {"type": "string", "minLength": 1, "maxLength": 40},
    "nullableText": {"type": ["string", "null"], "minLength": 1, "maxLength": 80},
    "public": {
      "description": "판단 전 구획 = contract PublicCase − {id, version}. 카드 메타는 가벼운 마스킹대로 연도·업종·규모만 보여 준다.",
      "type": "object",
      "additionalProperties": false,
      "required": ["yearPublic", "sectorPublic", "sizeBucket", "horizonDays", "difficulty", "panels", "evidenceOptions", "riskOptions"],
      "properties": {
        "yearPublic": {"description": "판단일의 연도(= reveal.outcome.startDate의 연도).", "type": "integer", "minimum": 1990, "maximum": 2100},
        "sectorPublic": {"type": "string", "minLength": 1, "maxLength": 20},
        "sizeBucket": {"enum": ["소형", "중형", "대형"]},
        "horizonDays": {"description": "판단 기간(일). 기본 180, 사례에 따라 90·365.", "enum": [90, 180, 365]},
        "difficulty": {"type": "integer", "minimum": 1, "maximum": 5},
        "panels": {
          "type": "object",
          "additionalProperties": false,
          "required": ["flow", "numbers", "then"],
          "properties": {
            "flow": {"$ref": "#/$defs/flowPanel"},
            "numbers": {"$ref": "#/$defs/numbersPanel"},
            "then": {"$ref": "#/$defs/thenPanel"}
          }
        },
        "evidenceOptions": {"type": "array", "minItems": 3, "maxItems": 8, "items": {"$ref": "#/$defs/evidenceOption"}},
        "riskOptions": {"type": "array", "minItems": 2, "maxItems": 6, "items": {"$ref": "#/$defs/riskOption"}}
      }
    },
    "flowPanel": {
      "description": "「흐름」: 판단일까지의 가격·시장 지수. 판단일 이후 구간은 넣지 않는다(tools/cards/flow_index.py).",
      "type": "object",
      "additionalProperties": false,
      "required": ["index14", "market14", "volumeTrend", "windowDays"],
      "properties": {
        "index14": {"$ref": "#/$defs/index14"},
        "market14": {"$ref": "#/$defs/index14"},
        "volumeTrend": {"description": "거래량 추이 낱말만(원시 거래량은 쓰지 않는다).", "enum": ["증가", "유지", "감소"]},
        "windowDays": {"description": "흐름 창의 길이(달력 일). 14점은 이 창을 고르게 나눈다.", "type": "integer", "minimum": 14, "maximum": 1095}
      }
    },
    "numbersPanel": {
      "description": "「숫자」: 판단일까지 공시된 재무 수치(문자열 그대로 보여 준다). 없는 값은 '데이터 없음' 또는 psr=null.",
      "type": "object",
      "additionalProperties": false,
      "required": ["growth", "valuation", "health", "asOfRelative"],
      "properties": {
        "growth": {
          "type": "object",
          "additionalProperties": false,
          "required": ["revYoy", "opm", "epsYoy", "guidance"],
          "properties": {
            "revYoy": {"$ref": "#/$defs/shortText"},
            "opm": {"$ref": "#/$defs/shortText"},
            "epsYoy": {"$ref": "#/$defs/shortText"},
            "guidance": {"$ref": "#/$defs/shortText"}
          }
        },
        "valuation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["per", "perSector", "pbr", "psr"],
          "properties": {
            "per": {"$ref": "#/$defs/shortText"},
            "perSector": {"$ref": "#/$defs/shortText"},
            "pbr": {"$ref": "#/$defs/shortText"},
            "psr": {"type": ["string", "null"], "minLength": 1, "maxLength": 40}
          }
        },
        "health": {
          "type": "object",
          "additionalProperties": false,
          "required": ["debtRatio", "netCash", "fcf"],
          "properties": {
            "debtRatio": {"$ref": "#/$defs/shortText"},
            "netCash": {"$ref": "#/$defs/shortText"},
            "fcf": {"$ref": "#/$defs/shortText"}
          }
        },
        "asOfRelative": {"description": "수치의 공시 시점. 예: 판단일 D-21(공시 기준)", "type": "string", "pattern": "^판단일 D-[0-9]+"}
      }
    },
    "thenPanel": {
      "description": "「그때」: 금리·환율·원자재와 판단일 전 소식. 문장은 사람이 템플릿으로 쓴다(LLM 생성 금지), 날짜는 상대 날짜, 출처는 종류만.",
      "type": "object",
      "additionalProperties": false,
      "required": ["rate", "rateTrend", "fxNote", "commodityNote", "notes"],
      "properties": {
        "rate": {"description": "기준금리. 예: 5.25~5.50%", "$ref": "#/$defs/shortText"},
        "rateTrend": {"enum": ["상승기", "동결", "하락기"]},
        "fxNote": {"$ref": "#/$defs/nullableText"},
        "commodityNote": {"$ref": "#/$defs/nullableText"},
        "notes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 5,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["when", "text", "sourceKind"],
            "properties": {
              "when": {"$ref": "#/$defs/relativeDay"},
              "text": {"type": "string", "minLength": 1, "maxLength": 120},
              "sourceKind": {"enum": ["공시", "보도", "통계"]}
            }
          }
        }
      }
    },
    "evidenceOption": {
      "description": "핵심 근거 칩. why는 '왜 중요한가' 한 줄(정답 방향을 암시하지 않는다).",
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "why", "panel"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{0,15}$"},
        "label": {"type": "string", "minLength": 1, "maxLength": 30},
        "why": {"type": "string", "minLength": 1, "maxLength": 80},
        "panel": {"enum": ["flow", "numbers", "then"]}
      }
    },
    "riskOption": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{0,15}$"},
        "label": {"type": "string", "minLength": 1, "maxLength": 30}
      }
    },
    "reveal": {
      "description": "공개 뒤 구획(server-only). outcome은 contract Outcome과 같은 모양.",
      "type": "object",
      "additionalProperties": false,
      "required": ["outcome", "keyPoints", "learningPoints"],
      "properties": {
        "outcome": {"$ref": "#/$defs/outcome"},
        "keyPoints": {
          "description": "사후에 중요했던 것(최대 3개).",
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "items": {"type": "string", "minLength": 1, "maxLength": 120}
        },
        "learningPoints": {
          "description": "학습 포인트 1~2개. conceptId는 content/concepts.json에 있어야 한다. rank 1이 공개 화면의 개념.",
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["conceptId", "rank", "linkSentence"],
            "properties": {
              "conceptId": {"type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"},
              "rank": {"type": "integer", "minimum": 1, "maximum": 2},
              "linkSentence": {"type": "string", "minLength": 1, "maxLength": 140}
            }
          }
        }
      }
    },
    "outcome": {
      "type": "object",
      "additionalProperties": false,
      "required": ["companyName", "ticker", "period", "startDate", "endDate", "returnPct", "benchReturnPct", "benchName", "pricePath", "benchPath", "sources"],
      "properties": {
        "companyName": {"type": "string", "minLength": 1},
        "ticker": {"type": "string", "minLength": 1},
        "period": {"description": "예: 2023 Q3 → 2024 Q1", "type": "string", "minLength": 1},
        "startDate": {"description": "판단일(판단 시점의 절대 날짜는 여기에만 있다).", "$ref": "#/$defs/isoDate"},
        "endDate": {"$ref": "#/$defs/isoDate"},
        "returnPct": {"description": "기간 수익률(%), 배당 재투자·분할 반영(총수익).", "type": "number"},
        "benchReturnPct": {"type": "number"},
        "benchName": {"type": "string", "minLength": 1},
        "pricePath": {"$ref": "#/$defs/index14"},
        "benchPath": {"$ref": "#/$defs/index14"},
        "sources": {
          "description": "출처. kind '가격'인 항목(파생 지수 원천과 배당·분할 반영 여부)이 반드시 있다. 예시 카드는 kind '예시' 항목도 둔다.",
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "label", "url"],
            "properties": {
              "kind": {"type": "string", "minLength": 1, "maxLength": 10},
              "label": {"type": "string", "minLength": 1, "maxLength": 120},
              "url": {"type": ["string", "null"], "pattern": "^https?://"}
            }
          }
        }
      }
    },
    "internal": {
      "description": "서버 전용(번들·응답에 나가지 않는다). leakTerms는 누수 사전(회사명·티커·제품명), dataCutoff는 카드에 들어간 정보의 마지막 날짜(≤ 판단일).",
      "type": "object",
      "additionalProperties": false,
      "required": ["notes", "leakTerms", "dataCutoff", "example"],
      "properties": {
        "notes": {"type": "string", "minLength": 1},
        "leakTerms": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "dataCutoff": {"$ref": "#/$defs/isoDate"},
        "example": {"description": "예시 카드(실측 아님)면 true.", "type": "boolean"}
      },
      "if": {"required": ["example"], "properties": {"example": {"const": true}}},
      "then": {"properties": {"notes": {"pattern": "^예시 자료\\(실측 아님\\)"}}}
    }
  }
}
